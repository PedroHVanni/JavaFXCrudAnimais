<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<AnchorPane

        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"

        fx:controller="com.template.controller.MainController"

        stylesheets="/style.css"

        prefHeight="500"
        prefWidth="823">


    <children>



        <!-- FUNDO -->

        <ImageView

                fitHeight="500"
                fitWidth="823"
                layoutX="0"
                layoutY="0">

            <image>

                <Image url="/images/fundo.jpg"/>

            </image>

        </ImageView>




        <!-- TEXTOS -->


        <Text layoutX="21" layoutY="61" text="Animal:">
            <font>
                <Font size="15"/>
            </font>
        </Text>


        <Text layoutX="21" layoutY="93" text="Cor:">
            <font>
                <Font size="15"/>
            </font>
        </Text>


        <Text layoutX="21" layoutY="126" text="Espécie:">
            <font>
                <Font size="15"/>
            </font>
        </Text>


        <Text layoutX="21" layoutY="158" text="Idade:">
            <font>
                <Font size="15"/>
            </font>
        </Text>


        <Text layoutX="21" layoutY="192" text="Sexo:">
            <font>
                <Font size="15"/>
            </font>
        </Text>





        <!-- CAMPOS -->


        <TextField
                fx:id="txtAnimal"
                layoutX="82"
                layoutY="42"
                prefWidth="220"/>


        <TextField
                fx:id="txtCor"
                layoutX="82"
                layoutY="75"
                prefWidth="220"/>


        <TextField
                fx:id="txtEspecie"
                layoutX="82"
                layoutY="108"
                prefWidth="220"/>


        <TextField
                fx:id="txtIdade"
                layoutX="82"
                layoutY="140"
                prefWidth="220"/>


        <TextField
                fx:id="txtSexo"
                layoutX="82"
                layoutY="174"
                prefWidth="220"/>






        <!-- BOTÕES -->


        <Button
                fx:id="btnSalvar"
                id="btnSalvar"
                layoutX="698"
                layoutY="274"
                prefHeight="41"
                prefWidth="120"
                text="Salvar"
                onAction="#btnSalvarAction"/>



        <Button
                fx:id="btnDeletar"
                id="btnDeletar"
                layoutX="698"
                layoutY="321"
                prefHeight="41"
                prefWidth="120"
                text="Deletar"
                onAction="#btnDeletarAction"/>



        <Button
                fx:id="btnAtualizar"
                id="btnAtualizar"

                layoutX="698"
                layoutY="368"

                prefHeight="41"
                prefWidth="120"

                text="Atualizar"

                onAction="#btnAtualizarAction"/>



        <Button
                fx:id="btnLimpar"
                id="btnLimpar"

                layoutX="698"
                layoutY="415"

                prefHeight="41"

                prefWidth="120"

                text="Limpar"

                onAction="#btnLimparAction"/>







        <!-- TABELA -->


        <TableView

                fx:id="tblAnimal"

                layoutX="21"

                layoutY="262"

                prefHeight="205"

                prefWidth="584">


            <columns>


                <TableColumn

                        fx:id="colId"

                        prefWidth="60"

                        text="ID"/>



                <TableColumn

                        fx:id="colAnimal"

                        prefWidth="120"

                        text="Animal"/>



                <TableColumn

                        fx:id="colCor"

                        prefWidth="110"

                        text="Cor"/>



                <TableColumn

                        fx:id="colEspecie"

                        prefWidth="110"

                        text="Espécie"/>



                <TableColumn

                        fx:id="colIdade"

                        prefWidth="80"

                        text="Idade"/>



                <TableColumn

                        fx:id="colSexo"

                        prefWidth="110"

                        text="Sexo"/>


            </columns>


        </TableView>





        <Label

                fx:id="lblTotalRegistros"

                layoutX="575"

                layoutY="39"

                text="0"/>

        <Label

                fx:id="lblMensagem"

                layoutX="21"

                layoutY="220"

                prefWidth="250"

                text=""/>
    </children>


</AnchorPane>